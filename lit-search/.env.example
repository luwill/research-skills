# 复制为 .env 并填入自己的值。.env 已被 .gitignore 排除，绝不入库。
# 真实环境变量优先于本文件——临时换 key 直接 export 即可，不必改文件。

# ─────────────────────────────────────────────────────────────
# 筛选用的 LLM。**这一段可以整段留空。**
#
# 不填任何 key 时用 `lit screen --model host`，由本机的 Claude Code 判定，
# 零配置。代价：每次调用有约 20,000 token 的框架开销，只适合 quick/standard
# 规模；实测 60 条记录约 $0.30 的 API 等价成本（订阅用户走自己的额度）。
#
# 上万条规模请配 API 后端——任何 OpenAI 兼容端点都可以。
# ─────────────────────────────────────────────────────────────

# 模型名。内置 deepseek-v4-flash（默认）/ deepseek-v4-pro / host。
# 用其它厂商时随便写，但必须同时给 BASE_URL。
LITSEARCH_LLM_MODEL=

# 端点。内置模型可省略；其它厂商必填，例如：
#   https://api.moonshot.cn/v1        （Kimi）
#   https://dashscope.aliyuncs.com/compatible-mode/v1  （Qwen）
#   https://openrouter.ai/api/v1      （OpenRouter）
#   http://localhost:11434/v1         （本地 Ollama）
LITSEARCH_LLM_BASE_URL=

# 密钥。旧变量名 DEEPSEEK_API_KEY 仍然认，新配置一律用这个。
LITSEARCH_LLM_API_KEY=

# 可选：自备价目表 JSON，用于给未内置的模型估算成本。格式：
#   {"kimi-k3": {"input_hit": 0.01, "input_miss": 1.0, "output": 2.0}}
# 不给的话 --dry-run 会如实报「无法估算」，而不是报一个假的 $0.00。
LITSEARCH_PRICING=

# ─────────────────────────────────────────────────────────────
# 检索源
# ─────────────────────────────────────────────────────────────

# OpenAlex。匿名配额约 1,000 信用点/天（每请求 10 点）；配 key 后 10,000。
# 没有它 OpenAlex 会在采集中途 QuotaExhausted，捕获-再捕获也就算不出来。
OPENALEX_API=

# 进 OpenAlex / Crossref 的 polite pool，并作为 Unpaywall 的必填联系邮箱。
# 这个是免费的，只是填个邮箱；缺了 `lit fulltext` 会直接拒绝跑。
CONTACT_EMAIL=

# 可选：PubMed 提速到 10 req/s（无 key 为 3 req/s）
NCBI_API_KEY=

# ⚠️ Semantic Scholar 源**当前版本尚未实现**。这个变量与限速值是给它预留的位置，
# 配上不会有任何效果：协议里写 semantic_scholar: enabled 会在源清单处被丢弃
#（`lit harvest` 与 `lit plan` 会红字提示，`coverage_report.md` 会记为未执行）。
#
# 这件事对非生物医学主题有实际影响：PubMed 用不上时，闭源出版商的摘要覆盖会明显
# 下降，而 S2 本该是补位的那个源。在它实现之前，这类主题的摘要缺口只能人工补。
S2_API_KEY=
